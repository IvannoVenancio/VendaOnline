generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int           @id @default(autoincrement())
  email           String        @unique @db.VarChar(100)
  name            String
  tipo_usuario    Int
  senha           String        @db.VarChar(100)
  tipo_usuario_rel TipoUsuario  @relation("user_tipo_usuario", fields: [tipo_usuario], references: [id])
  perfilId        Int?
  perfil          Perfil?       @relation(fields: [perfilId], references: [id])
  resumoCompras   ResumoCompra[]
  endereco        Endereco[]    // Relacionamento com Endereco
  carrinho        Carrinho[]    // Relacionamento com Carrinho
  avaliacoes      Avaliacao[]   // Relacionamento com Avaliação
  pedidos         Pedido[]      // Relacionamento com Pedido
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt @default(now())

  @@map("user")
}

model Perfil {
  id              Int      @id @default(autoincrement())
  nome_utilizador String?
  descricao       String?
  perfil_usuario  User[]   // Relacionamento com usuários
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt @default(now())

  @@map("perfil")
}

model TipoUsuario {
  id         Int      @id @default(autoincrement())
  type       String   @db.VarChar(30) @unique
  users      User[]   @relation("user_tipo_usuario") // Relacionamento de volta para User
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @default(now())

  @@map("tipo_usuario")
}

model TipoCategoria {
  id             Int       @id @default(autoincrement())
  tipo_categoria String    @db.VarChar(30) @unique
  imagem         String?   @db.VarChar(255)
  produtos       Produto[] @relation("Produtos_TipoCategoria") // Relacionamento com Produto
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @updatedAt @default(now())

  @@map("tipo_categoria")
}

model Produto {
  id               Int           @id @default(autoincrement())
  nome_produto     String        @db.VarChar(100)
  descricao        String?       @db.VarChar(1000)
  preco            Float
  quantidade       Int
  tipoCategoriaId  Int
  tipo_categoria   TipoCategoria @relation("Produtos_TipoCategoria", fields: [tipoCategoriaId], references: [id])
  detalhes         String        @db.VarChar(1500)
  imagem           String?       @db.VarChar(1500)
  resumoCompras    ResumoCompra[] // Relacionamento com ResumoCompra
  avaliacoes       Avaliacao[]   // Relacionamento com Avaliação
  carrinho         Carrinho[]    // Relacionamento com Carrinho
  itens            Item[]        // Relacionamento com Item (de volta)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  @@map("produto")
}

model Item {
  id             Int      @id @default(autoincrement())
  id_produto     Int
  produto        Produto  @relation(fields: [id_produto], references: [id]) // Relacionamento com Produto
  id_pedido      Int
  pedido         Pedido   @relation(fields: [id_pedido], references: [id]) // Relacionamento com Pedido
  quantidade     Int
  preco_unitario Float
  subtotal       Float
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("item")
}

model Pedido {
  id          Int       @id @default(autoincrement())
  data_Pedido DateTime  @default(now())
  id_usuario  Int
  user        User      @relation(fields: [id_usuario], references: [id]) // Relacionamento com User
  itens       Item[]    // Relacionamento com Item
  pagamentos  Pagamento[] // Relacionamento com Pagamento
  status      String
  valor_total Float
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  @@map("pedido")
}



model Pagamento {
  id               Int       @id @default(autoincrement())
  id_pedido        Int
  pedido           Pedido    @relation(fields: [id_pedido], references: [id]) // Relacionamento com Pedido
  valor_pago       Decimal
  metodo_pagamento String
  data_pagamento   DateTime  @default(now())
  status_pagamento String
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@map("pagamento")
}

model Endereco {
  id         Int      @id @default(autoincrement())
  id_usuario Int
  user       User     @relation(fields: [id_usuario], references: [id]) // Relacionamento com User
  cidade     String
  provincia  String
  pais       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("endereco")
}

model Avaliacao {
  id             Int      @id @default(autoincrement())
  id_produto     Int
  produto        Produto  @relation(fields: [id_produto], references: [id]) // Relacionamento com Produto
  id_usuario     Int
  user           User     @relation(fields: [id_usuario], references: [id]) // Relacionamento com User
  nota           Int
  comentario     String?
  data_avaliacao DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("avaliacao")
}

model Carrinho {
  id               Int      @id @default(autoincrement())
  id_usuario       Int
  user             User     @relation(fields: [id_usuario], references: [id]) // Relacionamento com User
  id_produto       Int
  produto          Produto  @relation(fields: [id_produto], references: [id]) // Relacionamento com Produto
  quantidade       Int      @default(1)
  valor_unitario   Float
  total            Float    @default(0)
  data_criacao     DateTime @default(now())
  data_atualizacao DateTime @updatedAt
  status           String
  imagem           String?  @db.VarChar(255)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("carrinho")
}

model ResumoCompra {
  id               Int      @id @default(autoincrement())
  id_usuario       Int
  user             User     @relation(fields: [id_usuario], references: [id]) // Relacionamento com User
  id_produto       Int
  produto          Produto  @relation(fields: [id_produto], references: [id]) // Relacionamento com Produto
  quantidade       Int
  preco_total      Float
  data_compra      DateTime @default(now())
  status           String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("resumo_compra")
}
