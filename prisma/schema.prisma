generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int           @id @default(autoincrement())
  email           String        @unique @db.VarChar(100)
  name            String
  senha           String        @db.VarChar(100)
  tipo_usuario    Int
  tipo_usuario_rel TipoUsuario  @relation("user_tipo_usuario", fields: [tipo_usuario], references: [id])
  perfilId        Int?
  perfil          Perfil?       @relation(fields: [perfilId], references: [id])
  resumoCompras   ResumoCompra[]
  endereco        Endereco[]    
  carrinho        Carrinho[]    
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  @@map("user")
}

model Perfil {
  id              Int      @id @default(autoincrement())
  nome_utilizador String?
  descricao       String?
  imagem          String?   @db.VarChar(1500) // Foto de perfil
  data_nascimento DateTime? // Data de nascimento do usuário
  telefone        String?   // Telefone do usuário
  pais            String?   // País do usuário
  perfil_usuario  User[]  

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("perfil")
}


model TipoUsuario {
  id         Int      @id @default(autoincrement())
  type       String   @db.VarChar(30) @unique
  users      User[]   @relation("user_tipo_usuario")
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @default(now())

  @@map("tipo_usuario")
}

model TipoCategoria {
  id             Int       @id @default(autoincrement())
  tipo_categoria String    @db.VarChar(30) @unique
  imagem         String?   @db.VarChar(255)
  produtos       Produto[] @relation("Produtos_TipoCategoria")
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @updatedAt

  @@map("tipo_categoria")
}

model Produto {
  id               Int           @id @default(autoincrement())
  nome_produto     String        @db.VarChar(100)
  descricao        String?       @db.VarChar(1000)
  preco            Float
  quantidade       Int
  tipoCategoriaId  Int
  tipo_categoria   TipoCategoria @relation("Produtos_TipoCategoria", fields: [tipoCategoriaId], references: [id])
  detalhes         String        @db.VarChar(1500)
  imagem           String?       @db.VarChar(1500)
  carrinho         Carrinho[]    
  resumoCompras    ResumoCompra[]
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  @@map("produto")
}

model Carrinho {
  id               Int      @id @default(autoincrement())
  id_usuario       Int
  user             User     @relation(fields: [id_usuario], references: [id])
  id_produto       Int
  produto          Produto  @relation(fields: [id_produto], references: [id])
  quantidade       Int      @default(1)
  valor_unitario   Float
  subtotal         Float    @default(0) // quantidade * valor_unitário
  status           String   @default("Em andamento") // "Em andamento", "Finalizado"
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("carrinho")
}

model ResumoCompra {
  id                Int      @id @default(autoincrement())
  id_usuario        Int
  user              User     @relation(fields: [id_usuario], references: [id])
  id_produto        Int
  produto           Produto  @relation(fields: [id_produto], references: [id])
  quantidade        Int
  valor_unitario    Float
  total             Float
  status_entrega    String   @default("Pedido recebido") // "Pedido recebido", "Em separação", etc.
  data_compra       DateTime @default(now())
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("resumo_compra")
}

model Endereco {
  id         Int      @id @default(autoincrement())
  id_usuario Int
  user       User     @relation(fields: [id_usuario], references: [id])
  cidade     String
  provincia  String
  pais       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("endereco")
}
