<h1>Lista de Usuários</h1>
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Nome</th>
      <th>Email</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody>
    {{#each users}}
    <tr>
      <td>{{this.id}}</td>
      <td>{{this.nome}}</td>
      <td>{{this.email}}</td>
      <td>
        <a href="/users/{{this.id}}">Detalhes</a>
        <form action="/users/{{this.id}}/delete" method="post" style="display:inline;">
          <button type="submit">Excluir</button>
        </form>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>
