<div class="container">
    <h1>Atualizar Usuário</h1>
    <form action="/users/{{user.id}}/update" method="POST">
        <div>
            <label for="nome">Nome:</label>
            <input type="text" id="nome" name="name" value="{{user.name}}" placeholder="Digite o nome" />
        </div>
        <div>
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" value="{{user.email}}" placeholder="Digite o email" />
        </div>
        <div>
            <label for="senha">Senha:</label>
            <input type="password" id="senha" value="{{user.senha}}" name="senha" placeholder="Digite a nova senha" />
        </div>
        <button type="submit">Atualizar</button>
    </form>
</div>
