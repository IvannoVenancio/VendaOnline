<h2>Todos os Resumos de Compra</h2>
<table>
    <tr>
        <th>ID</th>
        <th>Usuário</th>
        <th>Data</th>
        <th>Itens Comprados</th>
    </tr>
    {{#each resumos}}
    <tr>
        <td>{{this.id}}</td>
        <td>{{this.user.name}} ({{this.user.email}})</td>
        <td>{{this.data}}</td>
        <td>
            {{#each this.itens}}
                {{this.produtoNome}} - {{this.quantidade}}x <br>
            {{/each}}
        </td>
    </tr>
    {{/each}}
</table>
