<!DOCTYPE html>
<html lang="pt">
<head>
   <meta charset="UTF-8">
   <meta http-equiv="X-UA-Compatible" content="IE=edge">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   
   <!-- font awesome cdn link  -->
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

   <!-- custom css file link  -->
   <link rel="stylesheet" href="/css/produtoAndCard.css">

   <!-- custom js file link  -->
   <script src="/js/produtoAndCard.js" defer></script>

</head>
<body>
   
<div class="container">

   <h3 class="title"> Produtos </h3>

   <div class="products-container">
      {{#each produtos}}
      <div class="product" data-name="p-{{id}}">
                    <img src="{{imagem}}"  alt="Imagem do {{nome_produto}}">
         <h3>{{nome_produto}}</h3>
         <div class="preco">{{preco}}</div>
      </div>

      

      {{/each}}

     

</div>

<div class="products-preview">
   <!--Inicio da repetição da div de detalhes-->
{{#each produtos}}
   <div class="preview" data-target="p-{{id}}">
      <i class="fas fa-times"></i>
                    <img src="{{imagem}}"  alt="Imagem do {{nome_produto}}">
      <h3>{{nome_produto}}</h3>
            <div class="stars">
         <i class="fas fa-star"></i>
         <i class="fas fa-star"></i>
         <i class="fas fa-star"></i>
         <i class="fas fa-star"></i>
         <i class="fas fa-star-half-alt"></i>
         
      </div>
      
      <p>EIM-STORE</p>
      <div class="price">{{preco}}kzs</div>
      <div class="buttons">
<form action="/adicionar" method="POST">
    <input type="hidden" name="id_produto" value="{{this.id}}">
    <input type="hidden" name="quantidade" value="1">
    <button type="submit" class="cart">Adicionar ao Carrinho</button>
</form>
      </div>
   </div>
{{/each}}
<!--Final da repetição da div de detalhes-->
</div>


<script>
  async function adicionarProdutoAoCarrinho(id, quantidade) {
    const response = await fetch('/carrinho/adicionar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id_produto: id, quantidade })
    });

    const result = await response.json();
    alert(result.message);
  }
</script>

</body>
</html>