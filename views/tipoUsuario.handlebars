<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/tipos2.css">
    <title>Cadastro dos usuarios
    </title>
</head>
<body>
    
<form action="/tipo_usuario" method="post">
<label for="tipo_usuario">Tipo de Usuario</label>
    <input type="text" name="type" placeholder="Tipo de Usuario" ><br>
    
    <input type="submit" value="Cadastrar">
</form>

<table>
    {{!-- <tr>
        <td>#</td>
        <td>Tipo Usuario</td>
    </tr> --}}
    {{#each tipo_usuario}}
    <tr>
        <td>{{id}}</td>
        <td>{{type}}</td>
    </tr>
    {{/each}}
</table>
</body>
</html>