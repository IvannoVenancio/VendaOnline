<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carrinho</title>
    <link rel="stylesheet" href="/css/carrinho.css">
</head>
<body>
    <header>EIMSTORE</header>
    <main>
        <div class="page-title">Seu Carrinho</div>
        <div class="content">
            <section>
                {{#if carrinho}}
                <table>
                    <thead>
                        <tr>
                            <th>Imagem</th>
                            <th>Produto</th>
                           <th>Preço</th>
                           <th>      </th>
                           <th>Quantidade</th> 
                           <th>Sub-preço</th>                            
                        </tr>
                    </thead>
                    <tbody>
                        {{#each carrinho}}
                        <tr>
                            <td>
<img src="{{this.imagem}}" alt="{{this.nome_produto}}" width="100">
</td>

                            <td>
                                {{this.nome_produto}}
                            </td>
                            <td>{{this.preco}} KZ</td>
                            <td>
    <td>
    <button class="alterar-quantidade" data-id="{{this.id}}" data-acao="diminuir">➖</button>
    <span>{{this.quantidade}}</span>
    <button class="alterar-quantidade" data-id="{{this.id}}" data-acao="aumentar">➕</button>
</td>


                            <td id="subtotal-{{this.id}}">{{this.subtotal}} KZ</td>
                            <td>
                                <td>
   <td>
    <form action="/carrinho/atualizar" method="POST">
        <input type="hidden" name="id" value="{{this.id}}">
        <input type="number" name="quantidade" value="{{this.quantidade}}" min="1">
        <button type="submit">Atualizar</button>
    </form>
</td>

</td>

                            </td>
                            <td>
    <td>
    <form action="/carrinho/remover/{{this.id}}" method="POST">
        <button type="submit">Remover</button>
    </form>
</td>

</td>

                        </tr>
                        {{/each}}
                    </tbody>
                </table>
                {{else}}
                <p>O carrinho está vazio.</p>
                {{/if}}
            </section>
            <aside>
                <div class="box">
                    <header>Resumo da Compra</header>
                    <div class="info">
                        <div><span>Sub-Total</span><span>{{total}} KZ</span></div>
                        <div><span>Frete</span><span>Gratuito</span></div>
                        <div><button class="resumo-button">Adicionar cupom de Desconto</button></div>
                    </div>
                    <footer>
                        <span>Total</span>
                        <span>{{total}} KZ</span>
                    </footer>
                </div>
<form action="/carrinho/finalizar" method="POST">
    <button type="submit">Finalizar Compra</button>
</form>



            </aside>
        </div>
    </main>

    <script src="/js/carrinho.js"></script>
</body>
</html>
 
