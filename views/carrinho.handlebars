<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carrinho</title>
    <link rel="stylesheet" href="/css's/carrinho.css">
</head>
<body>
    <header>EIMSTORE</header>
    <main>
        <div class="page-title">Seu Carrinho</div>
        <div class="content">
            <section>
                {{#if carrinho}}
                <table>
                    <thead>
                        <tr>
                            <th>Produto</th>
                            <th>Preço</th>
                            <th>Quantidade</th>
                            <th>Total</th>
                            <th>-</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each carrinho}}
                        <tr>
                            <td>{{this.produto.nome_produto}}</td>
                            <td>{{this.produto.preco}}</td>
                            <td>{{this.quantidade}}</td>
                            <td>{{this.total}}</td>
                            <td><button class="remove">X</button></td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
                {{else}}
                <p>{{mensagem}}</p>
                {{/if}}
            </section>
            <aside>
                <div class="box">
                    <header>Resumo da Compra</header>
                    <div class="info">
                        <div><span>Sub-Total</span><span>{{total}} KZ</span></div>
                        <div><span>Frete</span><span>Gratuito</span></div>
                        <div><button class="resumo-button">Adicionar cupom de Desconto</button></div>
                    </div>
                    <footer>
                        <span>Total</span>
                        <span>{{total}} KZ</span>
                    </footer>
                </div>
                <button class="resumo-button">Finalizar Compra</button>
            </aside>
        </div>
    </main>
    <script src="/js/carrinho.js"></script>
</body>
</html>
