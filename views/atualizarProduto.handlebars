<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Produto</title>
    <link rel="stylesheet" href="/css's/editarproduto.css">
</head>
<body>
    <div class="container">
        <!-- Seção para exibir a imagem -->
        <div class="form-image">
            <img src="{{produto.imagem}}" alt="Imagem do Produto">
        </div>

        <!-- Formulário de edição -->
        <div class="form">
            <div class="form-header">
                <h1>Editar Produto</h1>
            </div>

            <form action="/produtos/{{produto.id}}/atualizar" method="POST" enctype="multipart/form-data">
                <div class="input-group">
                    <!-- Nome do produto -->
                    <div class="input-box">
                        <label for="nome_produto">Nome:</label>
                        <input type="text" id="nome_produto" name="nome_produto" value="{{produto.nome_produto}}" required>
                    </div>

                    <!-- Descrição -->
                    <div class="input-box">
                        <label for="descricao">Descrição:</label>
                        <input type="text" id="descricao" name="descricao" value="{{produto.descricao}}" required>
                    </div>

                    <!-- Preço -->
                    <div class="input-box">
                        <label for="preco">Preço:</label>
                        <input type="text" id="preco" name="preco" value="{{produto.preco}}" required>
                    </div>

                    <!-- Quantidade -->
                    <div class="input-box">
                        <label for="quantidade">Quantidade:</label>
                        <input type="number" id="quantidade" name="quantidade" value="{{produto.quantidade}}" required>
                    </div>

                    <!-- Detalhes -->
                    <div class="input-box">
                        <label for="detalhes">Detalhes:</label>
                        <input type="text" id="detalhes" name="detalhes" value="{{produto.detalhes}}" required>
                    </div>
                </div>

                <!-- Exibir categorias -->
                <div class="input-group">
                    <label>Categorias:</label>
                    {{#each idCategoria}}
                    <div>
                        <input type="radio" id="categoria-{{id}}" name="tipoCategoriaId" value="{{id}}" {{#ifEquals tipoCategoriaId id}}checked{{/ifEquals}}>
                        <label for="categoria-{{id}}">{{tipo_categoria}}</label>
                    </div>
                    {{/each}}
                </div>

                <!-- Botão de atualização -->
                <div class="continue-button">
                    <button type="submit">Atualizar</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
