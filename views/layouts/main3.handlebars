<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EIMSTORE</title>
    <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.1.0/css/font-awesome.min.css" rel="stylesheet">
    <link href='https://fonts.googleapis.com/css?family=Lato' rel='stylesheet' type='text/css'>
    <link rel="stylesheet" href="/css's/main3.css">
</head>
<body>

    <!-- Navbar -->
    <div class="navbar">
        <div class="header-inner-content">
            <h1 class="logo">EIM<span>STORE</span></h1>
            
            {{!-- <!-- Atalhos (Botões) -->
            <div class="atalhos">
                <a href="/login"><button>LOGIN</button></a>
                <a href="/categoria"><button>PRODUTOS</button></a>
                <a href="/carrinho"><button>CARRINHO</button></a>
                <a href="/perfil"><button>PERFIL</button></a>
            </div> --}}

            <!-- Ícone do menu -->
            <div class="menu-icon" onclick="toggleMenu()">
                <img src="/images/menu.png" class="menu-button">
            </div>
        </div>
    </div>

    <!-- Menu Oculto -->
    <div class="menu-hidden" id="menuHidden">
        <a href="/login"><button>LOGIN</button></a>
        <a href="/categoria"><button>PRODUTOS</button></a>
        <a href="/carrinho"><button>CARRINHO</button></a>
        <a href="/perfil"><button>PERFIL</button></a>
        <a href="/cadastro"><button>CADASTRO</button></a>

    </div>

    <script>
        function toggleMenu() {
            document.getElementById("menuHidden").classList.toggle("show");
        }
    </script>

</body>
</html>
